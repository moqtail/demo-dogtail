{
  "name": "dogtail",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 5174",
    "build": "tsc && vite build",
    "test": "vitest run",
    "format": "prettier --write .",
    "deploy": "npm run build && npx wrangler@4 deploy",
    "deploy:zafergurel": "npm run build && npx wrangler@4 deploy --env zafergurel",
    "bots": "node scripts/bots.mjs"
  },
  "devDependencies": {
    "playwright-core": "^1.65.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "moqtail": "^0.16.0",
    "posthog-js": "^1.447.10"
  },
  "packageManager": "npm@12.2.2",
  "allowScripts": {
    "core-js@3.51.0": true
  }
}
