// Static site on Cloudflare Workers: `npm run deploy` builds and uploads dist/ to dogtail.moqtail.dev.
// `npm run deploy:zafergurel` deploys the same build as a separate Worker on dogtail.zafergurel.com.
{
  "name": "dogtail",
  "compatibility_date": "2026-11-01",
  "assets": { "directory": "./dist" },
  "routes": [{ "pattern": "dogtail.moqtail.dev", "custom_domain": true }],
  "env": {
    "zafergurel": {
      "name": "dogtail-zafergurel",
      "routes": [{ "pattern": "dogtail.zafergurel.com", "custom_domain": true }],
    },
  },
}
